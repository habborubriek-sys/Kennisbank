# Voorbeeldconfiguratie. Kopieer naar .env (compose leest dat automatisch) of zet de waarden
# in het secret-/configbeheer van het platform. Volledige lijst: docs/configuratie.md

# --- Verplicht in productie ---
KB_SECRET_KEY=vervang-door-een-lange-willekeurige-waarde
KB_DATABASE_URL=postgres://kennisbank:wachtwoord@db-host:5432/kennisbank
KB_ALLOWED_HOSTS=kennisbank.example.nl
KB_CSRF_TRUSTED_ORIGINS=https://kennisbank.example.nl
KB_BASIS_URL=https://kennisbank.example.nl

# --- Inloggen via Entra ID (OpenID Connect) ---
KB_AUTH_MODUS=oidc
KB_OIDC_CLIENT_ID=00000000-0000-0000-0000-000000000000
KB_OIDC_CLIENT_SECRET=geheim
KB_OIDC_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
KB_OIDC_TOKEN_ENDPOINT=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
KB_OIDC_USERINFO_ENDPOINT=https://graph.microsoft.com/oidc/userinfo
KB_OIDC_JWKS_ENDPOINT=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
KB_OIDC_LOGOUT_ENDPOINT=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/logout
KB_OIDC_GEBRUIKERSNAAM_CLAIM=oid
KB_OIDC_GROEPEN_CLAIM=groups
KB_BEHEERDERS_GROEPEN=<object-id-van-de-beheerdersgroep>

# --- Inbedden in het zaaksysteem ---
KB_FRAME_ANCESTORS='self' https://zaaksysteem.example.nl
KB_COOKIE_SAMESITE=Lax

# --- AI-assistent (optioneel) ---
KB_AI_PROVIDER=uit
# KB_AI_PROVIDER=azure
# KB_AI_BASE_URL=https://<resource>.openai.azure.com
# KB_AI_MODEL=<deployment-naam>
# KB_AI_API_KEY=...

# --- E-mail (optioneel) ---
# KB_EMAIL_HOST=smtp.example.nl
# KB_EMAIL_AFZENDER=kennisbank@example.nl
