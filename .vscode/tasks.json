{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Kennisbank: migreren",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["manage.py", "migrate", "--noinput"],
      "options": { "env": { "KB_DEBUG": "1", "KB_DEMO_MODUS": "1", "KB_LOG_FORMAAT": "tekst", "KB_DATABASE_URL": "postgres://kennisbank:kennisbank@localhost:5432/kennisbank" } },
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "Kennisbank: database klaarzetten",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["manage.py", "kennisbank_demo"],
      "options": { "env": { "KB_DEBUG": "1", "KB_DEMO_MODUS": "1", "KB_LOG_FORMAAT": "tekst", "KB_DATABASE_URL": "postgres://kennisbank:kennisbank@localhost:5432/kennisbank" } },
      "dependsOn": "Kennisbank: migreren",
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "Kennisbank: tests",
      "type": "shell",
      "command": "${command:python.interpreterPath}",
      "args": ["manage.py", "test", "kennisbank"],
      "options": { "env": { "KB_DEBUG": "1", "KB_ALLOWED_HOSTS": "testserver", "KB_LOG_NIVEAU": "ERROR", "KB_DATABASE_URL": "postgres://kennisbank:kennisbank@localhost:5432/kennisbank" } },
      "group": "test"
    }
  ]
}
